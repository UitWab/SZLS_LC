# Copy to .env; use distinct random keys, each at least 16 characters.
MW_ADMIN_KEY=
MW_READ_KEY=
MW_PLC_KEY=
# One deployment serves one project; empty means A's V1 GLOBAL scope only.
MW_PROJECT_CODE=
MW_TELEMETRY_CAPACITY=2000
MW_TELEMETRY_TTL_SECONDS=3600
# A reads these variables when create_database_services() is called.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
